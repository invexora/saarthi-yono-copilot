PORT=5050
SAARTHI_ALLOWED_ORIGIN=http://localhost:8000
SAARTHI_AUTH_MODE=development
SAARTHI_DEPLOYMENT_MODE=local-prototype
SAARTHI_DATA_RESIDENCY=not-configured
SAARTHI_EVENT_STREAM_MODE=memory
SAARTHI_REDIS_URL=redis://localhost:6379/0
SAARTHI_EVENT_CONSUMER_GROUP=saarthi-workers
SAARTHI_EVENT_LAG_SLO_MAX=1000
SAARTHI_EVENT_PENDING_SLO_MAX=100
SAARTHI_EVENT_MAX_DELIVERY_ATTEMPTS=3
SAARTHI_EVENT_CLAIM_IDLE_MS=60000
SAARTHI_EVENT_WORKER_BLOCK_MS=1000
SAARTHI_EVENT_WORKER_BATCH_SIZE=25
SAARTHI_EVENT_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
# Optional. Defaults to the worker container hostname so replicas remain distinct.
# SAARTHI_EVENT_CONSUMER_NAME=saarthi-worker-1
SAARTHI_PRODUCT_CATALOG_MODE=memory
SAARTHI_DECISION_SECRET=replace-with-a-random-secret-from-your-secret-manager
SAARTHI_AUDIT_SECRET=replace-with-a-separate-audit-hmac-secret
SAARTHI_AUDIT_KEY_VERSION=v1
SAARTHI_POLICY_MINIMUM_APPROVAL=approved
SAARTHI_ARTIFACT_FEED_MODE=local
# Production only: base64-encoded raw 32-byte Ed25519 public key and stable key ID.
# SAARTHI_ARTIFACT_SIGNING_PUBLIC_KEY=replace-with-base64-ed25519-public-key
# SAARTHI_ARTIFACT_SIGNING_KEY_ID=sbi-governance-signing-2026-01
SAARTHI_HIGH_RISK_REVIEW_MODE=disabled
SAARTHI_SIGNAL_DETECTION_MODE=rules
SAARTHI_SIGNAL_DETECTION_MINIMUM_CONFIDENCE=0.60
# Production only:
# SAARTHI_SIGNAL_DETECTION_URL=https://sbi-signal-detection.example
# SAARTHI_SIGNAL_DETECTION_TOKEN=replace-with-workload-identity-token
SAARTHI_CUSTOMER_CONTEXT_MODE=synthetic
# Production only:
# SAARTHI_CUSTOMER_CONTEXT_URL=https://sbi-internal.example
# SAARTHI_CUSTOMER_CONTEXT_TOKEN=replace-with-workload-identity-token
SAARTHI_FULFILLMENT_MODE=synthetic
SAARTHI_FULFILLMENT_RECONCILIATION_RETRY_SECONDS=60
SAARTHI_FULFILLMENT_RECONCILIATION_BATCH_SIZE=25
SAARTHI_CASE_MANAGEMENT_MODE=synthetic
SAARTHI_CASE_RETRY_SECONDS=60
SAARTHI_CASE_SYNC_INTERVAL_SECONDS=300
SAARTHI_CASE_WORKER_BATCH_SIZE=25
SAARTHI_MONITORING_POLICY_ID=draft-segment-outcomes-v1
SAARTHI_MONITORING_POLICY_STATUS=draft
SAARTHI_MONITORING_MINIMUM_SAMPLE_SIZE=30
SAARTHI_MONITORING_MAXIMUM_COMPLAINT_RATE=0.05
SAARTHI_MONITORING_MAXIMUM_HARM_RATE=0.02
SAARTHI_MONITORING_MINIMUM_CONVERSION_RATIO=0.80
# Production only:
# SAARTHI_CASE_MANAGEMENT_URL=https://sbi-case-management.example
# SAARTHI_CASE_MANAGEMENT_TOKEN=replace-with-workload-identity-token
# Production only:
# SAARTHI_FULFILLMENT_URL=https://sbi-fulfillment.example
# SAARTHI_FULFILLMENT_TOKEN=replace-with-workload-identity-token
SAARTHI_JWT_SECRET=replace-with-the-sbi-identity-verification-secret
SAARTHI_JWT_ISSUER=sbi-identity
SAARTHI_JWT_AUDIENCE=saarthi-api
# Production identity mode:
# SAARTHI_AUTH_MODE=oidc
# SAARTHI_OIDC_JWKS_URL=https://identity.sbi.example/.well-known/jwks.json
# SAARTHI_OIDC_ALGORITHMS=RS256
NEO4J_AUTH=neo4j/replace-with-a-local-password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-local-password

# Integrated platform mode (Compose configures these automatically):
# SAARTHI_DATABASE_URL=postgresql+psycopg://saarthi:replace-password@postgres:5432/saarthi
# SAARTHI_EVENT_STREAM_MODE=redis
# SAARTHI_REDIS_URL=redis://redis:6379/0
# SAARTHI_PRODUCT_CATALOG_MODE=neo4j
